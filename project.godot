; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Signal Shift"
config/description="Connect the signal. Outsmart the grid."
config/version="0.1.0"
run/main_scene="res://scenes/boot/boot.tscn"
config/quit_on_go_back=false
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.039, 0.059, 0.122, 1)
boot_splash/stretch_mode=0
boot_splash/image="res://assets/branding/splash.png"
config/icon="res://icon.svg"

[autoload]

SignalBus="*res://scripts/core/signal_bus.gd"
SaveService="*res://scripts/services/save_service.gd"
AudioService="*res://scripts/services/audio_service.gd"
GameManager="*res://scripts/core/game_manager.gd"
DailyPuzzleService="*res://scripts/services/daily_puzzle_service.gd"
AdsService="*res://scripts/services/ads_service.gd"
PurchaseService="*res://scripts/services/purchase_service.gd"
SceneRouter="*res://scripts/core/scene_router.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=450
window/size/window_height_override=800
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[editor_plugins]

enabled=PackedStringArray("res://addons/admob/plugin.cfg")

[gui]

theme/custom="res://resources/themes/signal_theme.tres"
common/drop_mouse_on_gui_input_disabled=true

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.039, 0.059, 0.122, 1)

[signal_shift]

ads_backend_script=""
ads_backend_script.android="res://scripts/services/backends/admob_backend.gd"
ads_backend_script.ios="res://scripts/services/backends/admob_backend.gd"
purchase_backend_script=""
privacy_policy_url="https://github.com/sohaibaslam127/signal-shift/blob/main/docs/PRIVACY_POLICY.md"
