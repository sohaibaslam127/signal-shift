theme_override_colors/font_color = Color(1, 0.705882, 0.329412, 1)
text = "Left 0"

[node name="BoardArea" type="MarginContainer" parent="Safe/Column"]
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/margin_top = 12
theme_override_constants/margin_bottom = 12

[node name="Board" parent="Safe/Column/BoardArea" instance=ExtResource("4_board")]
