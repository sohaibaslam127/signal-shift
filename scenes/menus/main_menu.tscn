[node name="MainMenu" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_menu")

[node name="Background" type="Control" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
script = ExtResource("2_bg")
scenic = true

[node name="Safe" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("3_safe")

[node name="Column" type="VBoxContainer" parent="Safe"]
layout_mode = 2
theme_override_constants/separation = 14

[node name="TopBar" type="HBoxContainer" parent="Safe/Column"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="LevelPill" type="Button" parent="Safe/Column/TopBar"]
unique_name_in_owner = true
custom_minimum_size = Vector2(290, 84)
layout_mode = 2
theme_type_variation = &"PillButton"
script = ExtResource("8_pill")
title = "Level 1"

[node name="TopSpacer" type="Control" parent="Safe/Column/TopBar"]
layout_mode = 2
size_flags_horizontal = 3
mouse_filter = 2

[node name="HintPill" type="Button" parent="Safe/Column/TopBar"]
unique_name_in_owner = true
custom_minimum_size = Vector2(260, 84)
layout_mode = 2
theme_type_variation = &"PillButton"
script = ExtResource("8_pill")
icon_name = &"gift"
icon_color = Color(0.807843, 0.607843, 1, 1)
title = "Free Hint"

[node name="LogoSpacer" type="Control" parent="Safe/Column"]
layout_mode = 2
size_flags_vertical = 3
mouse_filter = 2

[node name="Logo" type="Control" parent="Safe/Column"]
custom_minimum_size = Vector2(0, 250)
layout_mode = 2
mouse_filter = 2
