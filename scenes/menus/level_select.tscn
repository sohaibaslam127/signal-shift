[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/level_select.gd" id="1_select"]
[ext_resource type="Script" path="res://scripts/ui/circuit_background.gd" id="2_bg"]
[ext_resource type="Script" path="res://scripts/ui/safe_area_container.gd" id="3_safe"]
[ext_resource type="PackedScene" path="res://scenes/components/secondary_button.tscn" id="4_button"]

[node name="LevelSelect" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_select")

[node name="Background" type="Control" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
script = ExtResource("2_bg")

[node name="Safe" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("3_safe")

[node name="Column" type="VBoxContainer" parent="Safe"]
layout_mode = 2
theme_override_constants/separation = 20

[node name="Header" type="HBoxContainer" parent="Safe/Column"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="BackButton" parent="Safe/Column/Header" instance=ExtResource("4_button")]
unique_name_in_owner = true
custom_minimum_size = Vector2(150, 96)
layout_mode = 2
size_flags_horizontal = 0
theme_type_variation = &"HudButton"
text = "Back"

[node name="Title" type="Label" parent="Safe/Column/Header"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"HeadingLabel"
text = "Levels"
horizontal_alignment = 1
text_overrun_behavior = 3

[node name="StarTotal" type="Label" parent="Safe/Column/Header"]
unique_name_in_owner = true
custom_minimum_size = Vector2(150, 0)
layout_mode = 2
theme_type_variation = &"StatLabel"
theme_override_colors/font_color = Color(1, 0.705882, 0.329412, 1)
text = "0 ★"
horizontal_alignment = 2

[node name="Scroll" type="ScrollContainer" parent="Safe/Column"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="Chapters" type="VBoxContainer" parent="Safe/Column/Scroll"]
unique_name_in_owner = true
layout_mode = 2
