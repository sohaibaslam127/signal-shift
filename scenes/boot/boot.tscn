[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/boot.gd" id="1_boot"]
[ext_resource type="Script" path="res://scripts/ui/circuit_background.gd" id="2_bg"]
[ext_resource type="Script" path="res://scripts/ui/logo_mark.gd" id="3_logo"]

